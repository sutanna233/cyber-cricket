assets/units/meme/*_[0-9].png
assets/units/meme/*_[0-9][0-9].png
assets/units/meme/*_keep.png
assets/units/meme/*_cut.png
assets/units/meme/*_i2i_*.png
assets/units/meme/*_style*.png

# 抓图缓存与验收截图
tools/meme_cache/
shots/
tools/qa/
